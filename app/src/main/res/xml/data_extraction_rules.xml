<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Nothing this app stores may leave the phone except through
     its own upload: the preferences hold the server URL with its ingest token,
     and the cache holds patients' step logs awaiting upload. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
